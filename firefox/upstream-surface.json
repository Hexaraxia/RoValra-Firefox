{
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting"
  ],
  "optional_permissions": [
    "webNavigation",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "https://games.roblox.com/*",
    "*://*.roblox.com/*",
    "https://gamejoin.roblox.com/v1/join-game-instance",
    "https://users.roblox.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "js": [
        "intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "js": [
        "public/Assets/data/serverid_extractor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "css/sitewide.css",
        "css/rovalra.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "public/Assets/*",
        "public/data/*",
        "Assets/data/serverid_extractor.js",
        "data/*",
        "intercept.js",
        "assets/*",
        "css/*"
      ],
      "matches": [
        "https://www.roblox.com/*",
        "*://*.roblox.com/*"
      ]
    }
  ]
}
